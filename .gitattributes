# Normalise line endings across platforms.
* text=auto eol=lf

# Keep the Composer dist tarball to just the runtime package. Everything below
# is development tooling that consumers never execute, so excluding it makes
# `composer require astermd/sdk` materially smaller and faster.
/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.php-cs-fixer.dist.php export-ignore
/.prettierignore    export-ignore
/CLAUDE.md          export-ignore
/CONTRIBUTING.md    export-ignore
/Dockerfile         export-ignore
/Makefile           export-ignore
/docker-compose.yml export-ignore
/phpstan.neon       export-ignore
/phpunit.xml.dist   export-ignore
