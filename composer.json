{
    "name": "astermd/sdk",
    "description": "Official PHP SDK for the AsterMD order-flow API.",
    "type": "library",
    "keywords": [
        "astermd",
        "sdk",
        "api-client",
        "telehealth",
        "healthcare",
        "psr-18",
        "psr-7"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "AsterMD",
            "email": "info@astermd.com"
        }
    ],
    "support": {
        "email": "info@astermd.com"
    },
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "nyholm/psr7": "^1.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": { "AsterMD\\Sdk\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "AsterMD\\Sdk\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "ci": ["@lint", "@stan", "@test"]
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable"
}
